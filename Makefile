APP_NAME = cmo

VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo "dev")
GOVULNCHECK_VERSION ?= v1.9.0

help: ## Show the targets
	@grep -E '^[a-zA-Z0-9_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-16s\033[0m %s\n", $$1, $$2}'

vet: ## Run go vet
	go vet ./...
	go vet -tags e2e ./test/e2e/...

build: ## Build ./cmo
	go build -ldflags "-X main.version=$(VERSION)" -o $(APP_NAME)

# Remove before copying: overwriting the file in place leaves macOS with a stale
# code signature for it, and the new binary gets killed (SIGKILL) when run.
INSTALL_DIR ?= $(if $(GOPATH),$(GOPATH),$(HOME)/go)/bin

install: build ## Install cmo into $GOPATH/bin
	mkdir -p $(INSTALL_DIR)
	rm -f $(INSTALL_DIR)/$(APP_NAME)
	cp $(APP_NAME) $(INSTALL_DIR)/$(APP_NAME)

lint: ## Run golangci-lint
	golangci-lint run ./...
	golangci-lint run --build-tags e2e ./test/e2e/...

test: ## Run the unit and integration tests
	go test ./... -v

# Runs the built binary as a real process against a fake API server. Also runs
# under `make test`, since it is an ordinary package.
integration-test: ## Run only the process-level integration tests
	go test ./test/integration/... -v -count=1

# Needs a real cluster: KUBECONFIG must point at it. It installs cert-manager,
# exercises every command, then uninstalls with --purge.
test-e2e: ## Run the end-to-end tests against $KUBECONFIG
	go test -tags e2e ./test/e2e/... -v -count=1 -timeout 45m

coverage: ## Print coverage per function
	go test ./... -coverprofile=coverage.out
	go tool cover -func=coverage.out

coverage-html: coverage ## Write coverage.html
	go tool cover -html=coverage.out -o coverage.html

govulncheck: ## Check dependencies for known vulnerabilities
	go run golang.org/x/vuln/cmd/govulncheck@$(GOVULNCHECK_VERSION) ./...

fmt: ## Format the code
	gofmt -w .
	goimports -w .

# docs/commands.md is every command's --help; regenerate it when a flag changes.
COMMANDS = install uninstall status doctor \
	issuer "issuer create selfsigned" "issuer create ca" "issuer create acme" "issuer list" "issuer get" "issuer delete" \
	cert "cert create" "cert list" "cert get" "cert delete" "cert renew" "cert inspect" version

docs: build ## Regenerate docs/commands.md from --help
	@{ echo "# cmo command reference"; echo; echo "Generated by \`make docs\` from \`cmo <command> --help\`."; \
	  echo; echo '## cmo'; echo; echo '```text'; ./$(APP_NAME) --help; echo '```'; \
	  for c in $(COMMANDS); do echo; echo "## cmo $$c"; echo; echo '```text'; ./$(APP_NAME) $$c --help; echo '```'; done; } > docs/commands.md

ci: lint vet test build ## What CI runs, minus e2e

clean: ## Remove build and coverage output
	rm -f $(APP_NAME) coverage.out coverage.html

.PHONY: help vet build install lint test integration-test test-e2e coverage coverage-html govulncheck fmt docs ci clean
.DEFAULT_GOAL := help
